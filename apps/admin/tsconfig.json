{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@repo/ui/*": ["../../packages/ui/src/*"],
      "~db/*": ["../../packages/db/src/*"],
      "~/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts"
, "../../packages/ui/src/hooks/use-mobile.ts"  ],
  "exclude": [
    "node_modules"
  ]
}
